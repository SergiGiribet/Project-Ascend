{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: build Project Ascend",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/std:c++17",
                "/W4",
                "/w15038",
                "/nologo",
                "/Fe${workspaceFolder}\\app\\ascend.exe",
                "${workspaceFolder}\\app\\main.cpp",
                "${workspaceFolder}\\app\\src\\*.cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\app"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "linux": {
                "command": "g++",
                "args": [
                    "-g",
                    "-std=c++17",
                    "-Wall",
                    "-Wextra",
                    "-Wpedantic",
                    "-o",
                    "${workspaceFolder}/app/ascend",
                    "main.cpp",
                    "src/*.cpp"
                ],
                "options": {
                    "cwd": "${workspaceFolder}/app"
                },
                "problemMatcher": [
                    "$gcc"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "MSVC on Windows, g++ on Linux. Same warnings policy on both: zero."
        }
    ],
    "version": "2.0.0"
}
