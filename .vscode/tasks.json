{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build Project Ascend",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/std:c++17",
                "/W4",
                "/w15038",
                "/nologo",
                "/Fe${workspaceFolder}\\app\\ascend.exe",
                "${workspaceFolder}\\app\\main.cpp",
                "${workspaceFolder}\\app\\src\\*.cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\app"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}